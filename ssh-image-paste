#!/bin/bash
#
# ssh-image-paste - Paste clipboard images to remote SSH servers
#
# Captures the current screenshot/image from macOS clipboard,
# uploads it to the remote server you're SSH'd into, and copies
# the remote path to your clipboard for easy pasting.
#
# Usage:
#   ssh-image-paste              # Auto-detect SSH target from terminal
#   ssh-image-paste user@host    # Specify target manually
#   ssh-image-paste --help       # Show help
#   ssh-image-paste --version    # Show version
#
# Environment variables:
#   SSH_IMAGE_PASTE_DIR   Remote directory (default: /tmp/clipboard)
#   SSH_IMAGE_PASTE_KEEP  Max images to keep (default: 20)
#
# Homepage: https://github.com/aikero-labs/ssh-image-paste
#

VERSION="1.0.0"

# --- i18n ---
if [[ "${LANG:-}" == zh_CN* ]] || [[ "${LANG:-}" == zh_TW* ]]; then
    MSG_NO_SSH="当前终端没有 SSH 连接"
    MSG_NO_IMAGE="剪贴板没有图片"
    MSG_SCP_FAIL="SCP 上传失败"
    MSG_UPLOADED="图片已上传"
    MSG_COPIED="已复制路径到剪贴板，Cmd+V 粘贴"
    MSG_CHOOSE="选择目标机器:"
    MSG_NO_PNGPASTE="未找到 pngpaste，请先安装: brew install pngpaste"
else
    MSG_NO_SSH="No active SSH connection in current terminal"
    MSG_NO_IMAGE="No image in clipboard"
    MSG_SCP_FAIL="SCP upload failed"
    MSG_UPLOADED="Image uploaded"
    MSG_COPIED="Remote path copied to clipboard. Cmd+V to paste"
    MSG_CHOOSE="Select target host:"
    MSG_NO_PNGPASTE="pngpaste not found. Install it: brew install pngpaste"
fi

# --- Help / Version ---
show_help() {
    cat <<'EOF'
ssh-image-paste - Paste clipboard images to remote SSH servers

USAGE
    ssh-image-paste              Auto-detect SSH target from terminal
    ssh-image-paste user@host    Upload to a specific host
    ssh-image-paste --help       Show this help
    ssh-image-paste --version    Show version

ENVIRONMENT VARIABLES
    SSH_IMAGE_PASTE_DIR    Remote directory for uploaded images
                           (default: /tmp/clipboard)
    SSH_IMAGE_PASTE_KEEP   Number of recent images to keep on remote
                           (default: 20)

HOW IT WORKS
    1. Grabs the image from macOS clipboard (via pngpaste)
    2. Detects which SSH session your terminal is connected to
    3. Uploads the image via SCP
    4. Copies the remote file path to your clipboard
    5. Shows a macOS notification

SUPPORTED TERMINALS
    iTerm2, Terminal.app, Warp, Ghostty, Alacritty, Kitty

REQUIREMENTS
    - macOS
    - pngpaste (brew install pngpaste)
    - Active SSH connection (or specify target manually)

HOMEPAGE
    https://github.com/aikero-labs/ssh-image-paste
EOF
}

show_version() {
    echo "ssh-image-paste $VERSION"
}

case "${1:-}" in
    --help|-h)  show_help; exit 0 ;;
    --version)  show_version; exit 0 ;;
esac

# --- Configuration ---
REMOTE_DIR="${SSH_IMAGE_PASTE_DIR:-/tmp/clipboard}"
KEEP_COUNT="${SSH_IMAGE_PASTE_KEEP:-20}"

# --- Locate pngpaste ---
PNGPASTE=""
for p in /opt/homebrew/bin/pngpaste /usr/local/bin/pngpaste; do
    if [[ -x "$p" ]]; then
        PNGPASTE="$p"
        break
    fi
done
if [[ -z "$PNGPASTE" ]]; then
    # Try PATH as last resort
    PNGPASTE=$(command -v pngpaste 2>/dev/null || true)
fi
if [[ -z "$PNGPASTE" ]]; then
    osascript -e "display notification \"$MSG_NO_PNGPASTE\" with title \"ssh-image-paste\""
    echo "$MSG_NO_PNGPASTE" >&2
    exit 1
fi

# --- SSH target detection ---
extract_ssh_target() {
    local ssh_line="$1"
    # Try user@host format first
    local target
    target=$(echo "$ssh_line" | grep -oE '[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+' | tail -1)
    if [[ -n "$target" ]]; then
        echo "$target"
        return
    fi
    # No @, extract SSH config alias (last non-option argument)
    local args=($ssh_line)
    local i=0
    local candidate=""
    while [[ $i -lt ${#args[@]} ]]; do
        local arg="${args[$i]}"
        case "$arg" in
            ssh) ;;
            -[bcDEeFIiJLlmOopQRSWw]) ((i++)) ;;
            -*) ;;
            *) candidate="$arg" ;;
        esac
        ((i++))
    done
    if [[ -n "$candidate" ]]; then
        local real_user real_host
        real_user=$(ssh -G "$candidate" 2>/dev/null | awk '/^user /{print $2}')
        real_host=$(ssh -G "$candidate" 2>/dev/null | awk '/^hostname /{print $2}')
        if [[ -n "$real_host" ]]; then
            echo "${real_user:-$USER}@${real_host}"
        else
            echo "$candidate"
        fi
    fi
}

get_ssh_from_tty() {
    local tty="$1"
    local ssh_line
    ssh_line=$(ps -t "${tty#/dev/}" -o args= 2>/dev/null | grep -m1 "[s]sh ")
    if [[ -n "$ssh_line" ]]; then
        extract_ssh_target "$ssh_line"
    fi
}

detect_ssh_target() {
    # Detect frontmost terminal app
    local frontapp
    frontapp=$(osascript -e 'tell application "System Events" to name of first application process whose frontmost is true' 2>/dev/null)

    local tty result
    if [[ "$frontapp" == "iTerm2" ]]; then
        tty=$(osascript -e 'tell application "iTerm2" to tty of current session of current window' 2>/dev/null)
    elif [[ "$frontapp" == "Terminal" ]]; then
        tty=$(osascript -e 'tell application "Terminal" to tty of selected tab of front window' 2>/dev/null)
    fi
    # Filter out AppleScript null ("missing value") and try TTY-based detection.
    # When we have a real TTY for the current session, its result is authoritative:
    # if the focused tab is local (no ssh on its tty), return empty so we do NOT
    # hijack the clipboard by uploading to an SSH session open in another tab.
    if [[ -n "$tty" && "$tty" != "missing value" ]]; then
        result=$(get_ssh_from_tty "$tty")
        echo "$result"
        return
    fi

    # Warp / Ghostty / Alacritty / Kitty / tmux -CC / others: no reliable per-session
    # TTY available, so fall back to scanning all SSH processes
    local ssh_lines ssh_hosts target line
    ssh_lines=$(ps -u "$USER" -o args= | grep "[s]sh " | grep -v "grep")
    ssh_hosts=""
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        target=$(extract_ssh_target "$line")
        [[ -n "$target" ]] && ssh_hosts+="$target"$'\n'
    done <<< "$ssh_lines"
    ssh_hosts=$(echo "$ssh_hosts" | sort -u | sed '/^$/d')
    local count
    count=$(echo "$ssh_hosts" | grep -c . 2>/dev/null || echo 0)

    if [[ "$count" -eq 1 ]]; then
        echo "$ssh_hosts"
    elif [[ "$count" -gt 1 ]]; then
        local list_items
        list_items=$(echo "$ssh_hosts" | sed 's/.*/"&"/' | paste -sd, -)
        local chosen
        chosen=$(osascript -e "choose from list {$list_items} with prompt \"$MSG_CHOOSE\" with title \"ssh-image-paste\"")
        [[ "$chosen" == "false" ]] && exit 0
        echo "$chosen"
    fi
}

# --- Determine target ---
if [[ -n "${1:-}" ]]; then
    REMOTE_HOST="$1"
else
    REMOTE_HOST=$(detect_ssh_target)
fi

if [[ -z "$REMOTE_HOST" ]]; then
    osascript -e "display notification \"$MSG_NO_SSH\" with title \"ssh-image-paste\""
    exit 1
fi

# --- Capture and upload ---
FILE="clip_$(date +%Y%m%d_%H%M%S).png"
REMOTE_PATH="$REMOTE_DIR/$FILE"

# Save clipboard image to temp file
"$PNGPASTE" "/tmp/$FILE" 2>/dev/null || {
    osascript -e "display notification \"$MSG_NO_IMAGE\" with title \"ssh-image-paste\""
    exit 1
}

# Upload via SCP and clean up old files
ssh -q "$REMOTE_HOST" "mkdir -p $REMOTE_DIR"
scp -q "/tmp/$FILE" "$REMOTE_HOST:$REMOTE_PATH" || {
    osascript -e "display notification \"$MSG_SCP_FAIL\" with title \"ssh-image-paste\""
    rm -f "/tmp/$FILE"
    exit 1
}
ssh -q "$REMOTE_HOST" "cd $REMOTE_DIR && ls -t clip_*.png | tail -n +$((KEEP_COUNT + 1)) | xargs rm -f 2>/dev/null"

# Clean up local temp
rm -f "/tmp/$FILE"

# Copy remote path to clipboard
echo -n "$REMOTE_PATH" | pbcopy

# Notify
osascript -e "display notification \"$MSG_COPIED\" with title \"$MSG_UPLOADED\" subtitle \"$REMOTE_PATH\""
